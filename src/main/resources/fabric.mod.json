  "authors": ["YourName"],
  "contact": {
    "homepage": "https://modrinth.com/mod/hatless",
    "sources": "https://github.com/YourName/hatless",
    "issues": "https://github.com/YourName/hatless/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.hatless.HatlessMod"],
    "client": ["dev.hatless.client.HatlessClient"]
  },
  "mixins": ["hatless.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
